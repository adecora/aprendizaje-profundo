{
  // Interprete de Python por defecto
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  // Fuera las sugerencias que más porculean en ty
  "ty.inlayHints.variableTypes": false,
  "ty.inlayHints.callArgumentNames": true,
  // Los autoimports siempre porcuelan
  "ty.completions.autoImport": false,
  "editor.rulers": [88, 120],
  // Habilita scroll en la salida de los notebooks, para no fumarnos salidas infinitas
  "notebook.output.scrolling": true,
  "notebook.lineNumbers": "on",

  // Configuración de Zen Mode
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
}